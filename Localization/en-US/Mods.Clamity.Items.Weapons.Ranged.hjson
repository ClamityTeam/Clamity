DepthsEchoRifle: {
	DisplayName: Depths Echo Rifle
	Tooltip: Converts musket balls into homing brimstone bolts
}

Obsidigun: {
	DisplayName: Obsidigun
	Tooltip: Converts musket balls into fast-moving obsidian bullets that break into many shards on hit
}

RoseBow: {
	DisplayName: Rose Bow
	Tooltip:
		'''
		Shoots a spread of arrows and homing petals
		'Even if you can't see me, even if you can't hear me, I'll be by your side'
		'''
}

WitheredBoneBow: {
	DisplayName: Wither Stormbow
	Tooltip:
		'''
		Converts wooden arrows to withered bone bolts
		Bolts creates a copy behind player on hit up to two times
		Bolts inflict [cbuff:CalamityMod/WitherDebuff] and have 15 armor penetration
		'Did I hear someone say taco?'
		'''
}

ShatteredPistol: {
	DisplayName: Shattered Pistol
	Tooltip:
		'''
		Shoot an imbued bullet by water
		Imbued bullet creates pircing shards on impact, dealing additional damage to the enemy they hit
		Any bullet type can be imbued when fired from this gun
		'''
}

AquarelPistol: {
	DisplayName: Aquarel Pistol
	Tooltip:
		'''
		Shoot an imbued bullet by water and ice
		Imbued bullet creates many pircing shards on impact, dealing additional damage to the enemy they hit
		Any bullet type can be imbued when fired from this gun
		'''
}

AbysscentPistol: {
	DisplayName: Abysscent Pistol
	Tooltip: ""
}
