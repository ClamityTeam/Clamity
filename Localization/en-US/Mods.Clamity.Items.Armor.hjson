	}

	AradirMask: {
		DisplayName: Aradir Mask
		Tooltip:
			'''
			Welcome to Math Hell:
			float b = MathF.Sin((Main.GlobalTimeWrappedHourly * (1 + lerp * 3) - j / 2f) 
			* (1 + new UnifiedRandom(i).NextFloat(0, 1))) * 0.33f * (1 + lerp * 3);

			WIP!
			'''
	}
}

FrozenHellstone: {
	FrozenHellstoneHeadMelee: {
		Tooltip:
			'''
			18% increased true melee damage
			True melee attacks inflict [cbuff:Frostburn]
			Enemies are more likely to target you
			'''
		DisplayName: Endobsidian Vanguard Helm
		SetBonus:
			'''
			Cannot be frozen.
			Press [KEY] to create an ice shield that parries attacks.
			
			'''
	}

	FrozenHellstoneGreaves: {
		Tooltip:
			'''
			20% increased true melee damage and +75 max life. 
			Enemies are more likely to target you
			'''
		DisplayName: Endobsidian Greaves
	}

	FrozenHellstoneChestplate: {
		Tooltip:
			'''
			20% increased true melee damage and 20% increased melee speed. 
			Enemies are more likely to target you
			'''
